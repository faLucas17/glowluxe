# Copier en backend/.env (local). Sur Render : onglet "Environment". Ne JAMAIS committer .env

DEBUG=True
SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
# En local avec DEBUG=True, toutes les adresses sont acceptées (IP Wi-Fi, ngrok…)
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
APP_URL=http://localhost:8081
ADMIN_URL=admin/

# Base de données (vide = SQLite local) ; Render la remplit automatiquement
# DATABASE_URL=postgres://user:password@host:5432/glowluxe

# Photos (OBLIGATOIRE en production) : Cloudinary > Dashboard > "API Environment variable"
CLOUDINARY_URL=

# Emails Brevo (vide = emails affichés dans le terminal)
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=GlowLuxe By Sofa <commandes@votredomaine.sn>
SHOP_NOTIFICATION_EMAIL=

# Paiements (vides = paiement manuel WhatsApp validé dans l'admin)
PAYMENT_TEST_MODE=True
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_SIGNING_SECRET=
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test

# Version web de l'appli (Cloudflare Pages) autorisée à appeler l'API
CORS_ALLOWED_ORIGINS=

# Premier administrateur (créé au déploiement)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
